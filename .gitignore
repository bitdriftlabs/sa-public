# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
.eggs/
venv/
.venv/
env/
.env/
.env
.env.local
.env.*.local
.pytest_cache/
.coverage
htmlcov/

# ── Rust ──────────────────────────────────────────────────────────────────
target/
Cargo.lock
output/

# ── Android / Gradle ──────────────────────────────────────────────────────
*.iml
*.class
*.apk
*.aab
*.aar
# bitdrift-shop-opentelemetry ships these local capture-sdk AARs directly (not yet in a
# published io.bitdrift:capture release) so the demo builds without a capture-sdk checkout.
!misc-demos/bitdrift-shop-opentelemetry/android/libs/*.aar
*.hprof
*.keystore
!debug.keystore
local.properties
.local.properties*
!misc-demos/bitdrift-shop-opentelemetry/android/.local.properties.example
.gradle/
captures/
build/
.externalNativeBuild/
.cxx/
.kotlin/

# ── iOS / Xcode ───────────────────────────────────────────────────────────
DerivedData/
*.ipa
*.dSYM.zip
*.dSYM
*.xcuserstate
*.xccheckout
*.hmap
*.moved-aside
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
**/.xcode.env.local
.local.xcconfig
.build/
.swiftpm/
Pods/
Podfile.lock
vendor/bundle/
# Test/coverage bundles — an .xcresult can run to hundreds of MB
*.xcresult
*.profraw
*.profdata
*.xcappdata
# Crash logs pulled off a device (this repo's demos generate a lot of them)
*.crash
*.ips
*.ips.synced
# Signing material and credentials — must never be committed. AuthKey_*.p8 is an
# App Store Connect API key, which Apple lets you download exactly once.
*.mobileprovision
*.provisionprofile
*.p12
*.pem
*.cer
*.certSigningRequest
AuthKey_*.p8
# NOTE: do NOT ignore Package.resolved. It pins the Capture SDK version, so
# committing it is what makes another machine resolve the same build.

# ── React Native ──────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
*.jsbundle
.npm/
.pnpm-store/
.expo/
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots
**/fastlane/test_output

# ── Local scratch/handoff notes (not for the PR/repo) ──────────────────────
bitdrift-shop/*/plans/

# ── macOS ─────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── IDE ───────────────────────────────────────────────────────────────────
.idea/
.vscode/
# Exception: the RN demo's debug configs are shared project setup, not personal IDE
# state. The default "Attach to packager" config silently produces no output on Hermes
# (which this app uses) — you need the "reactnativedirect" config instead. That is
# non-obvious enough to be worth shipping rather than making each person rediscover.
# Both the directory and the file must be re-included: git cannot un-ignore a file
# whose parent directory is excluded.
!bitdrift-shop/reactnative/.vscode/
!bitdrift-shop/reactnative/.vscode/launch.json
*.swp
*.swo
*.tmp
*.temp
*.log
