{
  "name": "bitdrift-shop-opentelemetry-ios — Capture All Sessions (Demo)",
  "platform_targets": [
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.oteldemo.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "session-start",
            "ootb_match": {
              "generic_condition": "APP_LAUNCH"
            }
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "trace-all-sessions",
      "start_tracing_rule": {
        "match_id": "session-start"
      }
    },
    {
      "rule_id": "capture-all-sessions",
      "flush_rule": {
        "match_id": "session-start"
      }
    }
  ]
}
