# These are NOT read from a runtime .env file. They are build-time values
# injected with `--dart-define=KEY=VALUE` (see scripts/run-app.sh and README).
#
# BITDRIFT_SDK_KEY   Your bitdrift Capture SDK key. Leave empty to run the app
#                    locally without sending data to bitdrift.
BITDRIFT_SDK_KEY=your_sdk_key_here
#
# BITDRIFT_API_HOST  Capture API host (defaults to https://api.bitdrift.io).
BITDRIFT_API_HOST=https://api.bitdrift.io
#
# BACKEND_PORT       Local FastAPI shop backend port (defaults to 5173).
BACKEND_PORT=5173
