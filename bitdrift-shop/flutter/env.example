# Copy to .env in this directory (flutter/.env) — this is the recommended way
# to set these values. scripts/android-3-start-app.sh and
# scripts/ios-3-start-app.sh both load it automatically. All values are
# build-time (--dart-define), not read at runtime. (A shell-exported variable
# of the same name overrides .env if you ever need that, e.g. CI.)
#
# BITDRIFT_SDK_KEY   Your bitdrift Capture SDK key. Leave empty to run the app
#                    locally without sending data to bitdrift.
BITDRIFT_SDK_KEY=your_sdk_key_here
#
# BITDRIFT_API_HOST  Capture API host (defaults to https://api.bitdrift.io).
BITDRIFT_API_HOST=https://api.bitdrift.io
#
# BACKEND_PORT       Local FastAPI shop backend port (defaults to 5173).
BACKEND_PORT=5173
