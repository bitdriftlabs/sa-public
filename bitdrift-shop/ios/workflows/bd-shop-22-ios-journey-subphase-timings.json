{
  "name": "bd-shop \u2014 iOS Journey Sub-Phase Timings",
  "platform_targets": [
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "discovery-fetch-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "discovery_fetch"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "product-view-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "product_view"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "wishlist-add-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "wishlist_add"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "cart-assembly-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "cart_assembly"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "checkout-payment-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "checkout.payment"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "checkout-confirmation-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "checkout.confirmation"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "any-phase-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "or_matcher": {
                      "matchers": [
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "discovery_fetch"
                          }
                        },
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "product_view"
                          }
                        },
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "wishlist_add"
                          }
                        },
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "cart_assembly"
                          }
                        },
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "checkout.payment"
                          }
                        },
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "checkout.confirmation"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "hist-discovery-fetch",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "discovery-fetch-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-product-view",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "product-view-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-wishlist-add",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "wishlist-add-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-cart-assembly",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "cart-assembly-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-checkout-payment",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "checkout-payment-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-checkout-confirmation",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "checkout-confirmation-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-compared",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "any-phase-end",
                "name": "_duration_ms"
              },
              "group_by": {
                "values": [
                  {
                    "field_key": "_span_name"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}