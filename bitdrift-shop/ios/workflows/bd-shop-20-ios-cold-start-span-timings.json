{
  "name": "bd-shop — iOS Cold-Start Span Timings",
  "platform_targets": [
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "cold-start-root-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "app_cold_start"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "cold-start-sdk-init-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "app_cold_start.sdk_init"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "cold-start-scene-render-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "app_cold_start.scene_render"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "cold-start-state-restore-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "app_cold_start.state_restore"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "cold-start-any-phase-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "or_matcher": {
                      "matchers": [
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "app_cold_start.sdk_init"
                          }
                        },
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "app_cold_start.scene_render"
                          }
                        },
                        {
                          "base_matcher": {
                            "log_field": "_span_name",
                            "operator": "EQUAL",
                            "string_value": "app_cold_start.state_restore"
                          }
                        }
                      ]
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "hist-root",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "cold-start-root-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-sdk-init",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "cold-start-sdk-init-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-scene-render",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "cold-start-scene-render-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-state-restore",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "cold-start-state-restore-end",
                "name": "_duration_ms"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "hist-phases-compared",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": {
                "match_id": "cold-start-any-phase-end",
                "name": "_duration_ms"
              },
              "group_by": {
                "values": [
                  {
                    "field_key": "_span_name"
                  }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
