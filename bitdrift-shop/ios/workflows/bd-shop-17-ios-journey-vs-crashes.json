{
  "name": "bd-shop — iOS Journey vs Crashes by Screen",
  "platform_targets": [
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "welcome-start",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "EQUAL",
                "string_value": "Welcome"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "any-screen",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "NOT_EQUAL",
                "string_value": "Confirmation"
              }
            }
          },
          "exit_conditions": [],
          "loop_match_id": "any-screen",
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "order-confirmed",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "EQUAL",
                "string_value": "Confirmation"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "previous-run-terminated",
            "generic_match": {
              "base_matcher": {
                "log_body": true,
                "operator": "EQUAL",
                "string_value": "previous_run_terminated"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "screen-visit",
            "ootb_match": {
              "apple_condition": "SCREEN_VIEW"
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "f-welcome",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "EQUAL",
                "string_value": "Welcome"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "f-discovery",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "IN",
                "string_value": "Browse~~Search~~Categories~~CategoryBrowse~~Featured"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "f-product",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "EQUAL",
                "string_value": "ProductDetail"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "f-cart",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "EQUAL",
                "string_value": "Cart"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "f-checkout",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "IN",
                "string_value": "CheckoutGuest~~CheckoutSignIn"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "f-payment",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "IN",
                "string_value": "PaymentCard~~PaymentApplePay~~PaymentPayPal~~PaymentAndroidPay"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "f-confirmation",
            "generic_match": {
              "base_matcher": {
                "log_field": "_screen_name",
                "operator": "EQUAL",
                "string_value": "Confirmation"
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "journey-sankey",
      "sankey_diagram_rule": {
        "nodes": [
          {
            "id": "welcome-start",
            "fixed": "Welcome"
          },
          {
            "id": "any-screen",
            "extract_field": "_screen_name"
          },
          {
            "id": "order-confirmed",
            "fixed": "Confirmation"
          }
        ]
      }
    },
    {
      "rule_id": "conversions",
      "metric_chart_rule": {
        "time_series": [
          {
            "count": {
              "value": {
                "match_id": "order-confirmed"
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "crashes-by-last-screen",
      "metric_chart_rule": {
        "time_series": [
          {
            "count": {
              "value": {
                "match_id": "previous-run-terminated"
              },
              "group_by": {
                "values": [
                  {
                    "field_key": "crashed_on_screen"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "terminations-by-reason",
      "metric_chart_rule": {
        "time_series": [
          {
            "count": {
              "value": {
                "match_id": "previous-run-terminated"
              },
              "group_by": {
                "values": [
                  {
                    "field_key": "termination_reason"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "screen-visits-by-name",
      "metric_chart_rule": {
        "time_series": [
          {
            "count": {
              "value": {
                "match_id": "screen-visit"
              },
              "group_by": {
                "values": [
                  {
                    "field_key": "_screen_name"
                  }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "journey-funnel",
      "funnel_rule": {
        "match_ids": [
          "f-welcome",
          "f-discovery",
          "f-product",
          "f-cart",
          "f-checkout",
          "f-payment",
          "f-confirmation"
        ]
      }
    }
  ]
}