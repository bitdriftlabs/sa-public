{
  "name": "bd-shop \u2014 iOS Screen Load Timings",
  "platform_targets": [
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "welcome-screen-end",
            "generic_match": {
              "and_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_field": "_span_name",
                      "operator": "EQUAL",
                      "string_value": "welcome_screen_load"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_field": "_span_type",
                      "operator": "EQUAL",
                      "string_value": "end"
                    }
                  }
                ]
              }
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
