{
  "name": "bd-shop — iOS User Journey to App Hang",
  "platform_targets": [
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "screen-view",
            "ootb_match": {
              "apple_condition": "SCREEN_VIEW"
            }
          },
          "exit_conditions": [],
          "loop_match_id": "screen-view",
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "app-hang",
            "ootb_match": {
              "apple_condition": "APP_IOS_BUILT_IN_ANR"
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    },
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "app-hang-standalone",
            "ootb_match": {
              "apple_condition": "APP_IOS_BUILT_IN_ANR"
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "journey-sankey",
      "sankey_diagram_rule": {
        "nodes": [
          {
            "id": "screen-view",
            "extract_field": "_screen_name"
          },
          {
            "id": "app-hang",
            "fixed": "App Hang"
          }
        ]
      }
    },
    {
      "rule_id": "capture-journey-hang",
      "flush_rule": {
        "applied_daily_limit": 100,
        "match_id": "app-hang"
      }
    },
    {
      "rule_id": "capture-standalone-hang",
      "flush_rule": {
        "applied_daily_limit": 100,
        "match_id": "app-hang-standalone"
      }
    }
  ]
}
