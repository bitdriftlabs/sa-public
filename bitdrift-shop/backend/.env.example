# Copy to .env. Only used when GRAFANA_ALLOY_ENABLED=true (docker-compose.alloy.yml).
GRAFANA_ALLOY_ENABLED=false

# Grafana Cloud OTLP credentials
# Find these in your Grafana Cloud stack: https://grafana.com/orgs/<your-org>/stacks
# -> Details -> OpenTelemetry (OTLP) -> "Configuration Details"
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-prod-us-east-0.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=your-instance-id
GRAFANA_CLOUD_API_TOKEN=your-api-token

# Honeycomb: an ingest API key for the target environment
HONEYCOMB_OTLP_ENDPOINT=https://api.honeycomb.io
HONEYCOMB_API_KEY=your-ingest-key

# ClickStack Cloud: hosted OTLP endpoint (port 4318) and ingestion key
CLICKSTACK_OTLP_ENDPOINT=https://your-clickstack-otlp-endpoint:4318
CLICKSTACK_API_KEY=your-ingestion-key
