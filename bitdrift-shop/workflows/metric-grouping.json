{
  "name": "bd-shop — Metric Grouping (Waveforms + Latency by Version)",
  "platform_targets": [
    {
      "android": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "exclusive": {},
      "steps": [
        {
          "match_rule": {
            "match_id": "metric-log",
            "generic_match": {
              "base_matcher": {
                "log_body": true,
                "operator": "EQUAL",
                "string_value": "metric_values"
              }
            }
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "metrics-chart",
      "metric_chart_rule": {
        "time_series": [
          { "average_count": { "numerator": { "match_id": "metric-log", "name": "metric_sine" } } },
          { "average_count": { "numerator": { "match_id": "metric-log", "name": "metric_square" } } },
          { "average_count": { "numerator": { "match_id": "metric-log", "name": "metric_sawtooth" } } },
          { "average_count": { "numerator": { "match_id": "metric-log", "name": "metric_triangle" } } },
          { "average_count": { "numerator": { "match_id": "metric-log", "name": "metric_dc" } } }
        ]
      }
    },
    {
      "rule_id": "counter-chart",
      "metric_chart_rule": {
        "time_series": [
          { "count": { "value": { "match_id": "metric-log", "name": "metric_counter" } } }
        ]
      }
    },
    {
      "rule_id": "work-latency-average",
      "metric_chart_rule": {
        "time_series": [
          {
            "average_count": {
              "numerator": { "match_id": "metric-log", "name": "metric_work_latency_ms" },
              "group_by": {
                "values": [
                  { "field_key": "sim_app_version" }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "work-latency-histogram",
      "metric_chart_rule": {
        "time_series": [
          {
            "histogram": {
              "value": { "match_id": "metric-log", "name": "metric_work_latency_ms" },
              "group_by": {
                "values": [
                  { "field_key": "sim_app_version" }
                ]
              }
            }
          }
        ]
      }
    },
    {
      "rule_id": "work-latency-table",
      "metric_chart_rule": {
        "time_series": [
          {
            "average_count": {
              "numerator": { "match_id": "metric-log", "name": "metric_work_latency_ms" },
              "group_by": {
                "values": [
                  { "field_key": "sim_app_version" }
                ]
              }
            }
          }
        ]
      }
    }
  ]
}
