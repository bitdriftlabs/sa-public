{
  "name": "bd-shop — Customer Support Sessions",
  "platform_targets": [
    {
      "android": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "support-log",
            "generic_match": {
              "base_matcher": {
                "log_field": "support",
                "operator": "EQUAL",
                "string_value": "true"
              }
            }
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "capture-support-session",
      "flush_rule": {
        "match_id": "support-log"
      }
    },
    {
      "rule_id": "support-log-count",
      "metric_chart_rule": {
        "time_series": [
          {
            "count": {
              "value": {
                "match_id": "support-log"
              }
            }
          }
        ]
      }
    }
  ]
}
