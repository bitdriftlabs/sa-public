{
  "name": "bd-shop — iOS Paths to Force Quit",
  "platform_targets": [
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "journey-start",
            "ootb_match": {
              "apple_condition": "SCREEN_VIEW"
            }
          },
          "exit_conditions": [],
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "screen-view",
            "ootb_match": {
              "apple_condition": "SCREEN_VIEW"
            }
          },
          "exit_conditions": [],
          "loop_match_id": "screen-view",
          "save_fields": []
        },
        {
          "match_rule": {
            "match_id": "app-termination",
            "ootb_match": {
              "apple_condition": "APP_TERMINATION"
            }
          },
          "exit_conditions": [],
          "save_fields": []
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "force-quit-sankey",
      "sankey_diagram_rule": {
        "nodes": [
          {
            "id": "journey-start",
            "fixed": "Journey Start"
          },
          {
            "id": "screen-view",
            "extract_field": "_screen_name"
          },
          {
            "id": "app-termination",
            "fixed": "Force Quit"
          }
        ]
      }
    }
  ]
}
