{
  "name": "bd-shop — Foreground Session Count (WIP)",
  "platform_targets": [
    {
      "android": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop"
          }
        ]
      }
    },
    {
      "apple": {
        "apps": [
          {
            "app_id": "ai.bitdrift.shop.ios"
          }
        ]
      }
    }
  ],
  "flows": [
    {
      "steps": [
        {
          "match_rule": {
            "match_id": "app-start",
            "generic_match": {
              "or_matcher": {
                "matchers": [
                  {
                    "base_matcher": {
                      "log_body": true,
                      "operator": "EQUAL",
                      "string_value": "AppStart"
                    }
                  },
                  {
                    "base_matcher": {
                      "log_body": true,
                      "operator": "EQUAL",
                      "string_value": "SceneWillEnterFG"
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "rule_id": "foreground-session-count",
      "metric_chart_rule": {
        "time_series": [
          {
            "count": {
              "value": {
                "match_id": "app-start"
              }
            }
          }
        ]
      }
    }
  ]
}
