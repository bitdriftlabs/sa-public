          "dashboard_layout_settings": {
            "x": 0,
            "y": 0,
            "column_span": 12,
            "row_span": 3
          }
        },
        {
          "id": "t-p",
          "text_component": {
            "text": "Children of the journey/product_discovery/checkout spans, nested via explicit parentSpanId \u2014 the SDK's own Logger.trackSpan can't do this, as it never forwards a parent. Android has only the one randomized journey (no simplified fixed-path mode as on iOS), so all six populate from the same path, wishlist_add included. Demo caveat: branch probabilities are variant-driven random walks and the interspersed delay(stepDelay) calls are artificial pacing, so raw durations mix both with real API time.",
            "variant": "p"
          },
          "dashboard_layout_settings": {
            "x": 0,
            "y": 3,
            "column_span": 12,
            "row_span": 8
          }
        },
