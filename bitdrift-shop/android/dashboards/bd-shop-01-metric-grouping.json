              }
            },
            "layout_settings": {
              "x": 0,
              "y": 3,
              "column_span": 12,
              "row_span": 4
            },
            "chart_metadata": {
              "title": "Work Latency by App Version (Average)",
              "summary": {
                "description": "Mean of metric_work_latency_ms, split by sim_app_version. Auto-rotates across all five simulated versions every 30s while Metrics is running on-device."
              },
              "metric_chart_metadata": {
                "time_series_display_mode": {},
                "metadata": [
                  {
                    "title": "Work latency",
                    "y_axis": {
                      "description": "Duration",
                      "unit": "MILLISECONDS"
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "chart_component_layout": {
            "chart_id": {
              "workflow": {
                "workflow_id": "__BD_SHOP_12_WORKFLOW_ID__",
                "chart_rule_id": "work-latency-histogram"
              }
            },
            "layout_settings": {
              "x": 0,
              "y": 7,
              "column_span": 12,
              "row_span": 4
            },
            "chart_metadata": {
              "title": "Work Latency by App Version (p50/p90/p99)",
              "summary": {
                "description": "Histogram of metric_work_latency_ms grouped by sim_app_version -- one percentile series per version, so a regression or a fix shows up as a shifted distribution, not just a moved average."
              },
              "metric_chart_metadata": {
                "time_series_display_mode": {},
                "metadata": [
                  {
                    "title": "Work latency",
                    "y_axis": {
                      "description": "Duration",
                      "unit": "MILLISECONDS"
                    }
